{
  "name": "dpdp-auditor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web",
    "dev:api": "python -m uvicorn apps.api.main:app --reload --port 8000",
    "lint:api": "ruff check apps/api",
    "test:api": "pytest apps/api",
    "build": "npm run build --workspace=apps/web",
    "lint": "npm run lint:web && npm run lint:api",
    "test": "npm run test:api"
  }
}
