# ==============================================================================
# DPDP 360° AI Compliance Auditor — Environment Configuration Template
# NOTE: Values below are placeholders. Never commit actual secret keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend / Public Environment Variables
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# Backend Gateway & Database
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Google Cloud & Vertex AI (Hosted in asia-south1 / asia-south2)
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
VERTEX_AI_GEMINI_FLASH_MODEL=gemini-1.5-flash
VERTEX_AI_GEMINI_PRO_MODEL=gemini-1.5-pro
VERTEX_AI_EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# Event Bus (Pub/Sub or Redis)
# ------------------------------------------------------------------------------
GCP_PUBSUB_TOPIC=dpdp-audit-events
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Web Automation & Anti-Bot Bypass (Stagehand / Scrapfly / Browserbase)
# ------------------------------------------------------------------------------
SCRAPFLY_API_KEY=your-scrapfly-api-key
STAGEHAND_API_KEY=your-stagehand-api-key
BROWSERBASE_API_KEY=your-browserbase-api-key
